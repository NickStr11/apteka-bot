{
    "manifest_version": 3,
    "name": "Apteka Order Helper",
    "version": "2.10",
    "description": "Заказ в один клик с Apteka.ru и Ютеки (самовывоз в Фарматек), цены Фарматека +5% на Ютеке",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://uteka.ru/*", "https://*.uteka.ru/*"],
            "js": ["uteka-hook.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://uteka.ru/*", "https://*.uteka.ru/*"],
            "js": ["uteka.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://apteka.ru/*"],
            "js": ["apteka-hook.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://apteka.ru/*"],
            "js": ["apteka.js"],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon128.png",
        "48": "icon128.png",
        "128": "icon128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}